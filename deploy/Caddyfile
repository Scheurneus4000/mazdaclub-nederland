# Caddy regelt automatisch gratis HTTPS-certificaten (Let's Encrypt).
# Zet DOMAIN in .env, bijv. DOMAIN=mazdaclub.nl

{$DOMAIN} {
	encode zstd gzip

	# Lange cache voor statische Next.js-bestanden
	@static path /_next/static/* /images/* /media/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	header {
		-Server
	}

	reverse_proxy app:3000
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
