# ─── Algemeen ───────────────────────────────────────────────
# Publieke URL van de site (zonder slash aan het eind). Wordt gebruikt voor
# betaal-redirects, webhooks, e-mails, sitemap en canonical-URL's.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Database (PostgreSQL) ──────────────────────────────────
# Lokaal met Docker:  postgresql://mazdaclub:mazdaclub@localhost:5432/mazdaclub?schema=public
# Lokaal zonder installatie: start `npm run db:dev` en plak de getoonde TCP-URL hier,
# aangevuld met &connection_limit=1&pgbouncer=true
#   postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=1&pgbouncer=true
DATABASE_URL="postgresql://mazdaclub:mazdaclub@localhost:5432/mazdaclub?schema=public"
# Alleen nodig met een connection pooler (Neon/Supabase): directe URL voor migraties.
# De Neon-integratie van Vercel zet automatisch DATABASE_URL_UNPOOLED; dat werkt ook.
DIRECT_URL=""

# ─── Eigenaar ───────────────────────────────────────────────
# E-mailadres(sen) van de eigenaar, komma-gescheiden. Een account met dit adres krijgt automatisch
# beheerdersrechten zodra het e-mailadres is bevestigd (via de link in de bevestigingsmail).
OWNER_EMAIL=""

# Optioneel: aparte sleutel voor het versleutelen van API-sleutels en wachtwoorden die je in het
# beheer invult. Leeg = afgeleid van AUTH_SECRET. Wijzig deze waarde niet meer na livegang.
SETTINGS_ENCRYPTION_KEY=""

# ─── Installatie ────────────────────────────────────────────
# Zelfgekozen geheime code voor /installatie (eerste beheerdersaccount aanmaken op de live site).
# De pagina werkt alleen zolang er nog geen beheerder bestaat.
SETUP_CODE=""

# ─── Authenticatie (Auth.js / NextAuth v5) ──────────────────
# Genereer met:  npx auth secret   (of: openssl rand -base64 32)
AUTH_SECRET="vervang-mij-door-een-lange-willekeurige-string"
# Zet op true achter een reverse proxy (Nginx/Caddy/Docker).
AUTH_TRUST_HOST=true

# ─── Betalingen ─────────────────────────────────────────────
# Tip: de betaalprovider en API-sleutels stel je ook (bij voorkeur) in via Beheer → Instellingen →
# Betalingen. Die instellingen gaan vóór de waarden hieronder.
# mock   = lokale testbetalingen zonder externe provider (alleen ontwikkeling)
# mollie = Mollie (aanbevolen: iDEAL | Wero, Bancontact, creditcard, Apple Pay, Google Pay, PayPal)
# stripe = Stripe Checkout (optioneel)
PAYMENT_PROVIDER="mock"
MOLLIE_API_KEY="test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ─── E-mail (Resend) ────────────────────────────────────────
# Tip: afzender, Resend-sleutel of een eigen mailserver (SMTP) stel je ook in via Beheer →
# Instellingen → E-mail. Die instellingen gaan vóór de waarden hieronder.
# Zonder sleutel worden e-mails alleen in de serverlog getoond.
RESEND_API_KEY=""
# Afzender: een adres op je eigen, in Resend geverifieerde domein (dus geen Gmail-adres).
EMAIL_FROM="MazdaClub Nederland <noreply@mazdaclubnederland.nl>"
# Reserve-ontvanger van contactformulieren. Normaal stel je de ontvanger in via Beheer → Instellingen.
ADMIN_EMAIL=""

# ─── Bestandsopslag ─────────────────────────────────────────
# local = schijf (LOCAL_UPLOAD_DIR), s3 = Cloudflare R2 of AWS S3
STORAGE_DRIVER="local"
LOCAL_UPLOAD_DIR="./storage/uploads"
# Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com, regio "auto"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Publieke basis-URL van de bucket, bijv. https://media.mazdaclub.nl
S3_PUBLIC_URL=""

# ─── Bescherming tegen spam en bots (optioneel) ─────────────
# Cloudflare Turnstile. Zonder sleutels geldt alleen honeypot + rate limiting.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ─── Geplande taken ─────────────────────────────────────────
# Beveiligt /api/cron/maintenance (verlopen lidmaatschappen, herinneringen, opruimen)
CRON_SECRET="vervang-mij"
